# ============================================================
# Ultron — Phase 1 (AI WebApp) environment variables
# Copy to .env.local and fill in. API keys are server-only
# (never NEXT_PUBLIC-prefixed).
# ============================================================

# --- LLM providers ---
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# --- Model ids (optional; shown are the current defaults) ---
GEMINI_MODEL=gemini-3.6-flash
XAI_MODEL=grok-4.6
# Free models on OpenRouter end with `:free` and need no billing.
OPENROUTER_MODEL=z-ai/glm-5.2:free

# --- Model fallbacks (comma-separated, optional) ---
# Tried in order when the primary model is rate-limited. Gemini meters its free
# tier per model (20 req/day each), so a rotation keeps the provider usable.
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash
OPENROUTER_MODEL_FALLBACKS=z-ai/glm-5.2:free,deepseek/deepseek-chat-v3-0324:free

# --- Web search for the search_web tool (all optional) ---
# The tool works with no keys at all: it layers Brave -> Tavily -> Serper ->
# keyless DuckDuckGo -> Wikipedia. Add a key to get better ranking/snippets.
#   Brave:   https://brave.com/search/api/
#   Tavily:  https://app.tavily.com
#   Serper:  https://serper.dev
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Voice: local browser Whisper needs no key ---
# Optional server-side STT fallback via Groq (free tier)
GROQ_API_KEY=

# --- LiveKit (realtime voice, like ChatGPT live mode) ---
# How to get free / local credentials:
#   Option A (hosted, free tier):  https://livekit.io -> Sign up -> Project (Free tier)
#     - LIVEKIT_URL   = wss://<project-name>.livekit.cloud
#     - LIVEKIT_API_KEY / LIVEKIT_API_SECRET from the project's Settings page.
#   Option B (local, fully free):  https://github.com/livekit/livekit
#     - Download the Linux/macOS/Windows binary, run:  livekit-server --dev
#     - LIVEKIT_URL   = ws://localhost:7880
#     - LIVEKIT_API_KEY = devkey  (default in --dev mode)
#     - LIVEKIT_API_SECRET = secret  (default in --dev mode)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Upstash (task queue / rate limiting) — optional for Phase 1 ---
# https://console.upstash.com -> Create Redis -> REST details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Turso / libSQL (durable store) — local file mode in Phase 1 ---
# file:local.db works with zero-config local SQLite via libSQL.
# To use the hosted tier, set:  libsql://<db>-<org>.turso.io  +  auth token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Firebase Cloud Firestore (alternative durable store) ---
# When set, the app switches from libSQL to Firestore automatically.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key -> download the JSON, then either:
#   A) paste the JSON as FIREBASE_SERVICE_ACCOUNT (raw JSON or base64), or
#   B) set GOOGLE_APPLICATION_CREDENTIALS to the path of the JSON file.
# Seed once after switching:  npm run db:seed
# FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_PROJECT_ID=